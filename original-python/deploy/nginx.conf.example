# Insert inside your existing HTTPS server block; do not overwrite the existing website.
# Subdirectory deployment: set BASE_PATH=/products in the application.
location = /products { return 302 /products/; }
location /products/ {
    client_max_body_size 105m;
    proxy_pass http://127.0.0.1:8088;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_request_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
# For a dedicated domain, use location / with the same proxy settings and BASE_PATH empty.
# Forward the full URL path unchanged; proxy_pass must NOT end in '/'.
# Configure a valid TLS certificate in your owning server block.
